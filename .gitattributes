# Bundled REA source hashes must be identical on Windows and CI checkouts.
apps/desktop/src-tauri/resources/plugins/rea/** text eol=lf
apps/desktop/src-tauri/resources/plugins/rea/runtime.zip -text
# Keep the restored Superpowers icon and source hash stable across checkouts too.
apps/desktop/src-tauri/resources/plugins/superpowers/** text eol=lf
# The wedecode bundle uses the same byte-for-byte source integrity gate.
apps/desktop/src-tauri/resources/plugins/wedecode/** text eol=lf
apps/desktop/src-tauri/resources/plugins/wedecode/runtime.zip -text
# Pet catalog sizes and hashes also require byte-stable text assets on Windows.
apps/desktop/src-tauri/resources/pets/dsh-pet/*.txt text eol=lf
apps/desktop/src-tauri/resources/pets/dsh-pet/*.md text eol=lf
