{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepAgent Studio Setup",
  "version": "0.0.8",
  "identifier": "com.deepagent.studio.installer",
  "build": {
    "beforeDevCommand": "pnpm dev", "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm build", "frontendDist": "../dist", "features": ["gui"]
  },
  "app": {
    "windows": [{ "label": "installer", "title": "DeepAgent Studio 安装程序", "width": 760, "height": 480, "center": true, "decorations": false, "resizable": false, "maximizable": false }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false, "icon": ["../../desktop/src-tauri/icons/icon.ico"] }
}
