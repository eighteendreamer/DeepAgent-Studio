{
  "identifier": "studio-canvas-capability",
  "description": "Minimal window controls for the isolated Studio Canvas window.",
  "windows": ["studio-canvas"],
  "permissions": [
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
