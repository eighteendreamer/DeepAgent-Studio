{
  "productName": "DeepAgent Studio",
  "version": "0.0.8",
  "identifier": "com.deepagent.studio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "splashscreen",
        "title": "DeepAgent Studio",
        "url": "splash.html",
        "width": 960,
        "height": 240,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": true
      },
      {
        "label": "main",
        "title": "DeepAgent Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/icon.png"],
    "resources": [
      "resources/plugins/**/*",
      "resources/mcp/**/*",
      "resources/skills/**/*",
      "resources/sandbox/**/*"
    ],
    "externalBin": ["binaries/deepagent"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyREFERkY1ODhGMkRDMzgKUldRNDNQS0k5ZC9hd21UTWNHUWJGSFRnZWd1S200NktGWG8rSnIzdjJGc2pjV0xVVU05QXRLNCsK",
      "endpoints": [
        "https://github.com/eighteendreamer/DeepAgent-Studio/releases/latest/download/latest.json",
        "https://download.deepagent.studio/releases/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
